generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assessment {
  id           String    @id @default(uuid())
  name         String?
  role         String?
  ministry     String?
  gender       String?
  ageGroup     String?
  churchSize   String?
  region       String?
  consentAgg   Boolean   @default(true)
  consentShare Boolean   @default(false)
  totalScore   Int?
  level        Int?
  domainScores Json?
  flags        Json?
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?

  responses Response[]
}

model Response {
  id           String   @id @default(uuid())
  assessmentId String
  questionId   String
  domain       String
  value        Int
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@unique([assessmentId, questionId])
}
